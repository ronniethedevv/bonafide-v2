{
  "name": "mm-reputation",
  "version": "0.0.1",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "description": "Privacy-preserving reputation record for crypto market makers (ZK on Midnight, deterministic Base indexer).",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "build": "pnpm -r --if-present build",
    "lint": "pnpm -r --if-present lint"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "classic-level"
    ],
    "overrides": {
      "@midnightntwrk/ledger-v9": "1.0.2",
      "@midnightntwrk/onchain-runtime-v4": "4.0.2",
      "@midnight-ntwrk/platform-js": "3.0.0"
    }
  }
}
