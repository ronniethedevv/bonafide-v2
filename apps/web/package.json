{
  "name": "web",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Public reputation profile + tear sheet (read-mostly) for BonaFide v2.",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/ensure-contract.mjs && node ./node_modules/@mmr/db/scripts/migrate.mjs && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "next lint",
    "test": "vitest run"
  },
  "dependencies": {
    "@midnight-ntwrk/compact-runtime": "0.21.0",
    "@mmr/contracts": "workspace:*",
    "@mmr/db": "workspace:*",
    "@mmr/engagement-file": "workspace:*",
    "@mmr/read-model": "workspace:*",
    "@walletconnect/ethereum-provider": "2.26.0",
    "jose": "6.2.14",
    "next": "15.5.29",
    "pg": "8.23.1",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "server-only": "0.0.1",
    "viem": "2.57.13"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.0.7",
    "@types/react-dom": "19.0.3",
    "typescript": "5.9.3",
    "vitest": "2.1.9"
  }
}
