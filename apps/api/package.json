{
  "name": "api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Read-model API (Fastify) serving the public reputation data to the web app.",
  "exports": {
    ".": "./src/server.ts"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@mmr/read-model": "workspace:*",
    "fastify": "5.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
