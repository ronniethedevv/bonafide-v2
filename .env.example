# Copy to .env and fill in. NEVER commit .env (.gitignore blocks .env*).
# See specs/MIDNIGHT_SETUP.md for how to obtain each value.

# --- Midnight (ZK contract tier) ---------------------------------------------
# One of: preview | preprod | mainnet. Start on preview (no token needed).
MIDNIGHT_NETWORK=preview

# Preview is Midnight-hosted and needs NO token. Leave Blockfrost blank for preview.
# Node RPC for preview (verify on the networks page):
MIDNIGHT_NODE_RPC_URL=https://rpc.preview.midnight.network

# Indexer endpoint (verify; preview is Midnight-hosted, preprod/mainnet use Blockfrost):
MIDNIGHT_INDEXER_URL=

# Local proof server from `docker run` in the setup guide (verify port):
MIDNIGHT_PROOF_SERVER_URL=http://localhost:6300

# Required ONLY for preprod and mainnet (one token per network, not interchangeable).
# Create a Midnight project at https://blockfrost.io and paste the project_id.
BLOCKFROST_PROJECT_ID=

# Midnight wallet seed/mnemonic for the account that deploys and pays DUST fees.
# Keep this out of the repo and out of shell history. Prefer a secrets manager.
MIDNIGHT_WALLET_SEED=

# --- Base (indexer data source — NOT Midnight) -------------------------------
# Archive RPC on Base (Alchemy / QuickNode / Infura). Used by the deterministic indexer.
BASE_ARCHIVE_RPC_URL=

# --- IPFS (publishing Merkle trees) ------------------------------------------
# Pinata JWT or web3.storage token. Used by the live TreePublisher.
IPFS_PINNING_JWT=

# --- Web app: wallet sign-in (apps/web) ---------------------------------------
# Signs session cookies. REQUIRED in production (>= 32 chars); without it wallet
# sign-in is switched off and only demo accounts work. Generate: openssl rand -hex 32
SESSION_SECRET=

# Optional dedicated RPCs for verifying smart-contract wallet signatures (Safe,
# Coinbase Smart Wallet) via ERC-1271/6492. Blank = the chain's public RPC.
BASE_RPC_URL=
ETH_RPC_URL=

# Optional: let specific wallets sign in AS a demo account, for walkthroughs.
# Format: 0xAddress=mm:vega-mm,0xAddress=client:orion
DEMO_WALLET_LINKS=

# --- Database (accounts + engagement registry) ---------------------------------
# Postgres connection (on Vercel the Neon integration sets these automatically).
# Unset = preview mode: accounts live in a signed browser cookie, nothing is saved.
DATABASE_URL=
# Direct (non-pooled) URL for migrations, if your provider separates them.
DATABASE_URL_UNPOOLED=
# Tests only: a database whose role may CREATE DATABASE; each test run creates and
# drops its own throwaway database. Unset = DB tests are skipped.
TEST_DATABASE_URL=
