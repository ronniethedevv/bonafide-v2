{
  "name": "@mmr/dapp",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Midnight Preview deploy (ledger 9): provider wiring, headless wallet, DUST registration and deployment of epoch_proof and the test bond token.",
  "exports": {
    ".": "./src/index.ts",
    "./committee": "./src/committee.ts",
    "./contract": "./src/contract.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "deploy": "tsx src/deploy.ts",
    "register-dust": "tsx src/register-dust.ts",
    "proof-server": "docker run --rm -p 127.0.0.1:6300:6300 -v midnight-zk-params:/.cache/midnight --name mmr-proof-server midnightntwrk/proof-server:9.0.0"
  },
  "dependencies": {
    "@midnight-ntwrk/compact-js": "3.0.2",
    "@midnight-ntwrk/compact-runtime": "0.21.0",
    "@midnight-ntwrk/midnight-js-contracts": "5.0.1",
    "@midnight-ntwrk/midnight-js-http-client-proof-provider": "5.0.1",
    "@midnight-ntwrk/midnight-js-indexer-public-data-provider": "5.0.1",
    "@midnight-ntwrk/midnight-js-level-private-state-provider": "5.0.1",
    "@midnight-ntwrk/midnight-js-node-zk-config-provider": "5.0.1",
    "@midnight-ntwrk/midnight-js-protocol": "5.0.1",
    "@midnight-ntwrk/midnight-js-types": "5.0.1",
    "@midnight-ntwrk/midnight-js-utils": "5.0.1",
    "@midnight-ntwrk/platform-js": "3.0.0",
    "@midnightntwrk/ledger-v9": "1.0.2",
    "@midnightntwrk/onchain-runtime-v4": "4.0.2",
    "@midnightntwrk/wallet-sdk": "2.0.1",
    "@mmr/contracts": "workspace:*",
    "@mmr/indexer": "workspace:*",
    "@mmr/merkle": "workspace:*",
    "@mmr/prover": "workspace:*",
    "bip39": "^3.1.0",
    "dotenv": "^16.4.7",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@midnight-ntwrk/testkit-js": "5.0.1",
    "@types/node": "^22.10.2",
    "tsx": "4.19.2",
    "typescript": "^5.7.2"
  }
}
