{
  "name": "@mmr/dapp",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Midnight testnet deploy + interact: provider wiring, headless wallet, contract deployment, and per-circuit transaction builders for epoch_proof.",
  "exports": {
    ".": "./src/index.ts",
    "./committee": "./src/committee.ts",
    "./contract": "./src/contract.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "deploy:preview": "tsx src/deploy.ts",
    "deploy": "tsx src/deploy.ts",
    "interact": "tsx src/interact.ts",
    "register-dust": "tsx src/register-dust.ts",
    "batch-deploy": "tsx src/batch-deploy-run.ts",
    "register-check": "tsx src/register-check.ts",
    "proof-server": "docker run --rm -p 6300:6300 --name mmr-proof-server midnightntwrk/proof-server:8.1.3"
  },
  "dependencies": {
    "@mmr/contracts": "workspace:*",
    "@mmr/indexer": "workspace:*",
    "@mmr/merkle": "workspace:*",
    "@mmr/prover": "workspace:*",
    "@midnight-ntwrk/compact-runtime": "0.16.0",
    "@midnight-ntwrk/compact-js": "2.5.1",
    "@midnight-ntwrk/platform-js": "2.2.4",
    "@midnight-ntwrk/onchain-runtime-v3": "3.0.0",
    "@midnight-ntwrk/midnight-js-contracts": "4.1.1",
    "@midnight-ntwrk/midnight-js-types": "4.1.1",
    "@midnight-ntwrk/midnight-js-network-id": "4.1.1",
    "@midnight-ntwrk/midnight-js-utils": "4.1.1",
    "@midnight-ntwrk/midnight-js-protocol": "4.1.1",
    "@midnight-ntwrk/midnight-js-indexer-public-data-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-level-private-state-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-http-client-proof-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-node-zk-config-provider": "4.1.1",
    "@midnightntwrk/wallet-sdk": "1.2.0",
    "bip39": "^3.1.0",
    "dotenv": "^16.4.7",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@midnight-ntwrk/testkit-js": "4.1.1",
    "@types/node": "^22.10.2",
    "tsx": "4.19.2",
    "typescript": "^5.7.2"
  }
}
