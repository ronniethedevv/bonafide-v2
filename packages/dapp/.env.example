# @mmr/dapp — Midnight Preview deploy configuration.
# Copy to packages/dapp/.env (gitignored) and fill DEPLOY_SEED.
# NEVER commit .env or the seed.

NETWORK_ID=preview
MIDNIGHT_NODE_URL=https://rpc.preview.midnight.network
MIDNIGHT_INDEXER_URL=https://indexer.preview.midnight.network/api/v4/graphql
MIDNIGHT_INDEXER_WS_URL=wss://indexer.preview.midnight.network/api/v4/graphql/ws
PROOF_SERVER_URL=http://localhost:6300

# Per-circuit proof timeout, ms. The SDK default is 300000 (5 min), which a
# k=20 proveEpoch proof exceeds on a laptop proof server.
MMR_PROOF_TIMEOUT_MS=2700000

# The deploy wallet's 24-word BIP-39 mnemonic (same one as Lace, Network=Preview).
DEPLOY_SEED=

# How long to wait for the wallet to reach a synced state, ms. A first sync on
# Preview replays ~280k wallet indices from genesis (measured ~130/s shielded,
# ~60/s dust) and takes 40-80 min, so this default is generous.
MMR_SYNC_TIMEOUT_MS=5400000

# Added to every declared fee. A DUST spend is not refunded, so this is spent in
# full; feeBlocksMargin already covers price rises and the SDK default is 0.
# It also inflates what a first DUST registration must wait to accrue.
MMR_ADDITIONAL_FEE_OVERHEAD=0

# How long to wait for retroactive DUST to accrue to a NIGHT UTXO, ms.
MMR_DUST_WAIT_TIMEOUT_MS=1800000
