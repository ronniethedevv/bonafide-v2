    "open": "tsx scripts/open-engagement.mts"
  },
  "dependencies": {
    "@noble/curves": "1.9.1"
  },
  "devDependencies": {
    "@mmr/merkle": "workspace:*",
    "@mmr/prover": "workspace:*",
    "tsx": "4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "viem": "2.57.13"
  }
}
