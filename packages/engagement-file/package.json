{
  "name": "@mmr/engagement-file",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Engagement secrets the MM must keep (passphrase-encrypted file), protocol-exact registration commitments, and the sealed MM-to-client channel. Runs in browsers and Node (WebCrypto).",
  "exports": {
    ".": "./src/index.ts",
    "./verify": "./src/verify.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
