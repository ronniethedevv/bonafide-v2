// registration.compact — secret-based engagement registration (build-order #3)
//
// UNVERIFIED SKELETON. Not compiled against compactc in this repo (no Midnight
// toolchain here). Syntax to be confirmed with Compact 0.31.x; semantics follow
// INVARIANTS.md (I9) and the product spec's engagement state machine.
//
// Privacy: the wallet vector, salt, and deal terms are PRIVATE witnesses and
// never disclosed. Only the engagement commitment and a random engagement id
// reach the ledger. An engagement runs under a random id and is linked to the
// MM's profile only later, via epoch_proof.claim (I10, H4).

pragma language_version 0.23.0;

import CompactStandardLibrary;

// Private deal terms. MUST stay field-for-field identical to `Terms` in
// epoch_proof.compact: proveEpoch recomputes persistentCommit<Terms> over its
// opened terms and the caller checks it equals termsCommit[id] (C2). The KAT
// in packages/contracts/test checks the two circuits agree.
struct Terms {
  floor_price_P: Uint<64>, loan_L0: Uint<128>, quote_start_Q0: Uint<128>,
  disposal_D: Uint<128>, net_sell_S: Uint<128>, depth_target: Uint<128>,
  roundtrip_share_ppm: Uint<64>, band_bps: Uint<64>,
  // H4 (DD-12): I6 pass threshold (bucket count) and committed contract length in epochs.
  min_uptime_buckets: Uint<64>, epochs_total: Uint<64>
}

// --- Public ledger state -----------------------------------------------------

// Engagement lifecycle, keyed by the random engagement id.
export enum Status { Registered, Funded, Active, Settled, Voided, Defaulted }

export ledger status: Map<Bytes<32>, Status>;
// Commitment over the 16-slot wallet vector (persistentCommit with a fresh salt).
export ledger walletCommit: Map<Bytes<32>, Bytes<32>>;
// Salted commitment persistentCommit<Terms>(terms, termsSalt) over the private
// deal terms. Salted because terms are low-entropy (a bare hash could be
// brute-forced). Opened only to the client off-chain.
export ledger termsCommit: Map<Bytes<32>, Bytes<32>>;
// Registration time, used by the 72h funding window.
export ledger registeredAt: Map<Bytes<32>, Uint<64>>;
// Difficulty tier declared at registration (A/B/C). Public.
export ledger tier: Map<Bytes<32>, Uint<8>>;

// --- Private witnesses -------------------------------------------------------

// The MM's registration secret. Authorization is "prove knowledge of this",
// never ownPublicKey() (I9).
witness engagementSecret(): Bytes<32>;
witness walletVector(): Vector<16, Uint<160>>;
witness walletSalt(): Bytes<32>;
witness terms(): Terms;
witness termsSalt(): Bytes<32>;

// --- Helpers -----------------------------------------------------------------

// I9: reject the Jubjub identity point as a key. In 0.31.x the standard
// signature check does not do this, so we check explicitly.
// The Jubjub identity (0,1) compresses to LE bytes [0x01, 0x00, ..., 0x00],
// which as a big-endian Compact Bytes<32> equals 2^248 cast via Field.
circuit assertNotIdentity(pk: ZswapCoinPublicKey): [] {
  const identityBytes = (452312848583266388373324160190187140051835877600158453279131187530910662656 as Field) as Bytes<32>;
  assert(pk.bytes != identityBytes, "identity-point key rejected (I9)");
}

// Derive the public engagement id deterministically from the secret, so the MM
// can recompute it but observers cannot link it to the MM.
circuit deriveEngagementId(secret: Bytes<32>): Bytes<32> {
  return persistentHash<Bytes<32>>(secret);
}

// --- Circuits ----------------------------------------------------------------

// H3: Compact exposes block time only through comparisons, never as a value, so the
// timestamp to record is an argument that is CHECKED against the block's own time:
// block time - REG_TS_TOLERANCE < registeredTs <= block time. A caller can no longer
// backdate (or postdate) registeredAt beyond the tolerance.
export circuit register(declaredTier: Uint<8>, registeredTs: Uint<64>): Bytes<32> {
  const REG_TS_TOLERANCE: Uint<64> = 600;   // 10 min: proof build -> block inclusion
  const ts = disclose(registeredTs);
  assert(blockTimeGte(ts), "registeredTs is in the future (H3)");
  assert(blockTimeLt((ts + REG_TS_TOLERANCE) as Uint<64>), "registeredTs too far in the past (H3)");
  const secret = engagementSecret();
  const id = deriveEngagementId(secret);
  assert(!status.member(disclose(id)), "engagement id already registered");

  // Commit the wallet vector over all 16 slots with a fresh salt. Unused slots
  // hold dummy addresses so the active wallet count never shows.
  const wc = persistentCommit<Vector<16, Uint<160>>>(walletVector(), walletSalt());
  const tc = persistentCommit<Terms>(terms(), termsSalt());

  status.insert(disclose(id), Status.Registered);
  walletCommit.insert(disclose(id), disclose(wc));
  termsCommit.insert(disclose(id), disclose(tc));
  registeredAt.insert(disclose(id), ts);
  tier.insert(disclose(id), disclose(declaredTier));
  return disclose(id);
}

// Activation: prove the loan reached the committed wallets, checked against the
// epoch root-of-roots so the pool stays hidden. The membership proof inputs are
// private; only the status transition is disclosed.
export circuit activate(id: Bytes<32>, rootOfRoots: Bytes<32>): [] {
  assert(status.lookup(disclose(id)) == Status.Registered, "not awaiting funding");
  // NOTE: funding membership proof verified here against rootOfRoots using the
  // same leaf/path scheme as @mmr/merkle. Omitted in this skeleton; see
  // epoch_proof.compact for the opening pattern.
  status.insert(disclose(id), Status.Funded);
}
