// epoch_proof.compact — per-epoch delivery proof, enforces I1-I8 (build-order #4)
//
// UNVERIFIED SKELETON. Follows INVARIANTS.md exactly. All wallet addresses,
// metrics, Merkle paths, salts, and deal terms are PRIVATE witnesses; the only
// disclosed outputs are the boolean epoch verdict and the public uptime count.
// Which pool and which wallets belong to the engagement are never disclosed.
//
// The leaf schema, indexed-tree opening, pool inclusion proof, and band opening
// mirror @mmr/merkle / @mmr/indexer. The production hash MUST be the circuit's
// Poseidon-family primitive, not the TS SHA-256 placeholder (DD-8).
//
// Compact 0.31.x constraints applied in this file:
//   - No top-level const (SLOTS=16, BUCKETS=48 are inlined as literals).
//   - No let / mutable scalar bindings; accumulators use helper circuits.
//   - Max Uint width is 248; floor_price_P is bounded to Uint<64> so that
//     16 slots × (quote_end + lp_quote) × P ≤ 16 × 2^128 × 2^64 = 2^196 < 2^248.

pragma language_version 0.23.0;

import CompactStandardLibrary;

// Per-slot opened leaf (membership) or low-leaf (non-membership). Metrics match
// the @mmr/merkle leaf schema; signed quantities are split in/out.
struct SlotLeaf {
  addr: Uint<160>,
  next_addr: Uint<160>,
  is_protocol: Boolean,
  base_start: Uint<128>, base_end: Uint<128>, quote_end: Uint<128>,
  lp_base: Uint<128>, lp_quote: Uint<128>,
  xfer_in: Uint<128>, xfer_out: Uint<128>, from_treasury: Uint<128>,
  swap_base_in: Uint<128>, swap_base_out: Uint<128>,
  swap_quote_in: Uint<128>, swap_quote_out: Uint<128>,
  depth_root: Bytes<32>, flow_root: Bytes<32>,
  present: Boolean            // true = membership, false = non-membership
}

// Private deal terms (committed at registration; opened here as a witness).
// floor_price_P is Uint<64> (not Uint<128>) to bound quote-valued sums within
// Uint<248>: max sum = 16 × 2^128 × 2^64 = 2^196 < 2^248.
struct Terms {
  floor_price_P: Uint<64>, loan_L0: Uint<128>, quote_start_Q0: Uint<128>,
  disposal_D: Uint<128>, net_sell_S: Uint<128>, depth_target: Uint<128>,
  roundtrip_share_ppm: Uint<64>, band_bps: Uint<64>
}

// Key for the per-epoch uptime record written to the public ledger.
struct EpochRef { id: Bytes<32>, epoch: Uint<64> }

// C1 — Merkle path step: sibling digest + left/right flag (mirrors PathStep in @mmr/merkle).
struct PathStep { sibling: Bytes<32>, weAreRight: Boolean }

// C1 — Hashable leaf core (all SlotLeaf fields except the circuit-only `present` flag).
//
// persistentHash<SlotLeafCore>(core) hashes 19 field elements, NOT a flat byte array:
//   addr(1 FE), next_addr(1 FE), is_protocol(1 FE), 12×metric(1 FE each),
//   depth_root(2 FEs: high-8 bits || low-248 bits), flow_root(2 FEs: same split).
// The atom byte sizes do match encodeLeaf — [20,20,1,16×12,32,32] = 297 bytes total —
// but Bytes<32> is split across two field elements because 256 > 248-bit field capacity.
// DD-8: the TS CompactHasher must feed these field elements to Poseidon, not hash the
// raw 297-byte buffer. See specs/progress_tracker.md §DD-8.
struct SlotLeafCore {
  addr: Uint<160>, next_addr: Uint<160>, is_protocol: Boolean,
  base_start: Uint<128>, base_end: Uint<128>, quote_end: Uint<128>,
  lp_base: Uint<128>, lp_quote: Uint<128>,
  xfer_in: Uint<128>, xfer_out: Uint<128>, from_treasury: Uint<128>,
  swap_base_in: Uint<128>, swap_base_out: Uint<128>,
  swap_quote_in: Uint<128>, swap_quote_out: Uint<128>,
  depth_root: Bytes<32>, flow_root: Bytes<32>
}

// C1 — Pool-inclusion leaf. persistentHash<PoolEntry>(pe) hashes 3 field elements:
//   poolAddr(1 FE: 20 bytes), poolRoot(2 FEs: high-8 bits || low-248 bits).
// Atom bytes [20,32] = 52 bytes; the TS encodePoolLeaf byte order matches, but the
// hash input is 3 FEs, not the flat 52-byte buffer. See DD-8.
struct PoolEntry { poolAddr: Uint<160>, poolRoot: Bytes<32> }

export ledger epochUptime: Map<Bytes<32>, Uint<32>>;

witness committedWallets(): Vector<16, Uint<160>>;
witness walletSalt(): Bytes<32>;
witness slotLeaves(): Vector<16, SlotLeaf>;
witness terms(): Terms;
// Per-slot contracted-band minimum depths per bucket (opened from depth_root).
witness bidMin(): Vector<16, Vector<48, Uint<128>>>;
witness askMin(): Vector<16, Vector<48, Uint<128>>>;

// C1 witnesses: Merkle paths that bind every slot leaf and the pool root to rootOfRoots.
// slotPaths: one depth-16 indexed-Merkle path per slot (mirrors IndexedMerkleTree depth 16).
witness slotPaths(): Vector<16, Vector<16, PathStep>>;
// poolEntry: the pool's (addr, treeRoot) pair; poolRoot is the indexed-tree root.
witness poolEntry(): PoolEntry;
// poolPath: depth-10 path from hashPoolEntry to rootOfRoots (POOL_TREE_DEPTH=10 in @mmr/merkle).
witness poolPath(): Vector<10, PathStep>;

// --- Helper: accumulate a single Uint<128> field across 16 present-only slots ---
// Returns the sum for a vector of 16 (present, value) pairs.

circuit sumSlots16(v: Vector<16, Uint<128>>, present: Vector<16, Boolean>): Uint<132> {
  const s0 = present[0] ? (v[0] as Uint<132>) : 0;
  const s1 = present[1] ? (v[1] as Uint<132>) : 0;
  const s2 = present[2] ? (v[2] as Uint<132>) : 0;
  const s3 = present[3] ? (v[3] as Uint<132>) : 0;
  const s4 = present[4] ? (v[4] as Uint<132>) : 0;
  const s5 = present[5] ? (v[5] as Uint<132>) : 0;
  const s6 = present[6] ? (v[6] as Uint<132>) : 0;
  const s7 = present[7] ? (v[7] as Uint<132>) : 0;
  const s8 = present[8] ? (v[8] as Uint<132>) : 0;
  const s9 = present[9] ? (v[9] as Uint<132>) : 0;
  const s10 = present[10] ? (v[10] as Uint<132>) : 0;
  const s11 = present[11] ? (v[11] as Uint<132>) : 0;
  const s12 = present[12] ? (v[12] as Uint<132>) : 0;
  const s13 = present[13] ? (v[13] as Uint<132>) : 0;
  const s14 = present[14] ? (v[14] as Uint<132>) : 0;
  const s15 = present[15] ? (v[15] as Uint<132>) : 0;
  const a = ((s0 + s1) as Uint<133>) + ((s2 + s3) as Uint<133>);
  const b = ((s4 + s5) as Uint<133>) + ((s6 + s7) as Uint<133>);
  const c = ((s8 + s9) as Uint<133>) + ((s10 + s11) as Uint<133>);
  const d = ((s12 + s13) as Uint<133>) + ((s14 + s15) as Uint<133>);
  return (((a + b) as Uint<135>) + ((c + d) as Uint<135>)) as Uint<132>;
}

// Sum (quote_end + lp_quote) * P for 16 slots.
// Tight bound: each term ≤ (2^128 + 2^128) × (2^64 - 1) < 2^129 × 2^64 = 2^193.
// 16 terms ≤ 16 × 2^193 = 2^197.
circuit sumQuoteAtP(L: Vector<16, SlotLeaf>, P: Uint<64>): Uint<197> {
  const q0 = L[0].present ? ((L[0].quote_end as Uint<129>) + (L[0].lp_quote as Uint<129>)) * P : 0;
  const q1 = L[1].present ? ((L[1].quote_end as Uint<129>) + (L[1].lp_quote as Uint<129>)) * P : 0;
  const q2 = L[2].present ? ((L[2].quote_end as Uint<129>) + (L[2].lp_quote as Uint<129>)) * P : 0;
  const q3 = L[3].present ? ((L[3].quote_end as Uint<129>) + (L[3].lp_quote as Uint<129>)) * P : 0;
  const q4 = L[4].present ? ((L[4].quote_end as Uint<129>) + (L[4].lp_quote as Uint<129>)) * P : 0;
  const q5 = L[5].present ? ((L[5].quote_end as Uint<129>) + (L[5].lp_quote as Uint<129>)) * P : 0;
  const q6 = L[6].present ? ((L[6].quote_end as Uint<129>) + (L[6].lp_quote as Uint<129>)) * P : 0;
  const q7 = L[7].present ? ((L[7].quote_end as Uint<129>) + (L[7].lp_quote as Uint<129>)) * P : 0;
  const q8 = L[8].present ? ((L[8].quote_end as Uint<129>) + (L[8].lp_quote as Uint<129>)) * P : 0;
  const q9 = L[9].present ? ((L[9].quote_end as Uint<129>) + (L[9].lp_quote as Uint<129>)) * P : 0;
  const q10 = L[10].present ? ((L[10].quote_end as Uint<129>) + (L[10].lp_quote as Uint<129>)) * P : 0;
  const q11 = L[11].present ? ((L[11].quote_end as Uint<129>) + (L[11].lp_quote as Uint<129>)) * P : 0;
  const q12 = L[12].present ? ((L[12].quote_end as Uint<129>) + (L[12].lp_quote as Uint<129>)) * P : 0;
  const q13 = L[13].present ? ((L[13].quote_end as Uint<129>) + (L[13].lp_quote as Uint<129>)) * P : 0;
  const q14 = L[14].present ? ((L[14].quote_end as Uint<129>) + (L[14].lp_quote as Uint<129>)) * P : 0;
  const q15 = L[15].present ? ((L[15].quote_end as Uint<129>) + (L[15].lp_quote as Uint<129>)) * P : 0;
  const a = ((q0 + q1) as Uint<194>) + ((q2 + q3) as Uint<194>);
  const b = ((q4 + q5) as Uint<194>) + ((q6 + q7) as Uint<194>);
  const c = ((q8 + q9) as Uint<194>) + ((q10 + q11) as Uint<194>);
  const d = ((q12 + q13) as Uint<194>) + ((q14 + q15) as Uint<194>);
  return (((a + b) as Uint<196>) + ((c + d) as Uint<196>)) as Uint<197>;
}

// Extract 16 presence flags from the leaf vector.
circuit presentFlags(L: Vector<16, SlotLeaf>): Vector<16, Boolean> {
  return [L[0].present, L[1].present, L[2].present, L[3].present,
          L[4].present, L[5].present, L[6].present, L[7].present,
          L[8].present, L[9].present, L[10].present, L[11].present,
          L[12].present, L[13].present, L[14].present, L[15].present];
}

// Sum per-slot bid depths for bucket b across 16 slots.
circuit bidSum(bid: Vector<16, Vector<48, Uint<128>>>, b: Uint<6>): Uint<132> {
  const s0 = bid[0][b] as Uint<132>;
  const s1 = bid[1][b] as Uint<132>;
  const s2 = bid[2][b] as Uint<132>;
  const s3 = bid[3][b] as Uint<132>;
  const s4 = bid[4][b] as Uint<132>;
  const s5 = bid[5][b] as Uint<132>;
  const s6 = bid[6][b] as Uint<132>;
  const s7 = bid[7][b] as Uint<132>;
  const s8 = bid[8][b] as Uint<132>;
  const s9 = bid[9][b] as Uint<132>;
  const s10 = bid[10][b] as Uint<132>;
  const s11 = bid[11][b] as Uint<132>;
  const s12 = bid[12][b] as Uint<132>;
  const s13 = bid[13][b] as Uint<132>;
  const s14 = bid[14][b] as Uint<132>;
  const s15 = bid[15][b] as Uint<132>;
  const a = ((s0 + s1) as Uint<133>) + ((s2 + s3) as Uint<133>);
  const c = ((s8 + s9) as Uint<133>) + ((s10 + s11) as Uint<133>);
  const e = ((s4 + s5) as Uint<133>) + ((s6 + s7) as Uint<133>);
  const g = ((s12 + s13) as Uint<133>) + ((s14 + s15) as Uint<133>);
  return (((a + e) as Uint<135>) + ((c + g) as Uint<135>)) as Uint<132>;
}

// I6: count passing buckets across all 48 buckets.
// A bucket passes when sumBid[b] >= target AND sumAsk[b] >= target.
circuit uptimeCount(bid: Vector<16, Vector<48, Uint<128>>>,
                    ask: Vector<16, Vector<48, Uint<128>>>,
                    target: Uint<128>): Uint<8> {
  const u0 = (bidSum(bid, 0 as Uint<6>) >= (target as Uint<132>)
              && bidSum(ask, 0 as Uint<6>) >= (target as Uint<132>)) ? 1 : 0;
  const u1 = (bidSum(bid, 1 as Uint<6>) >= (target as Uint<132>)
              && bidSum(ask, 1 as Uint<6>) >= (target as Uint<132>)) ? 1 : 0;
  const u2 = (bidSum(bid, 2 as Uint<6>) >= (target as Uint<132>)
              && bidSum(ask, 2 as Uint<6>) >= (target as Uint<132>)) ? 1 : 0;
  const u3 = (bidSum(bid, 3 as Uint<6>) >= (target as Uint<132>)
              && bidSum(ask, 3 as Uint<6>) >= (target as Uint<132>)) ? 1 : 0;
  const u4 = (bidSum(bid, 4 as Uint<6>) >= (target as Uint<132>)
              && bidSum(ask, 4 as Uint<6>) >= (target as Uint<132>)) ? 1 : 0;
  const u5 = (bidSum(bid, 5 as Uint<6>) >= (target as Uint<132>)
              && bidSum(ask, 5 as Uint<6>) >= (target as Uint<132>)) ? 1 : 0;
  const u6 = (bidSum(bid, 6 as Uint<6>) >= (target as Uint<132>)
              && bidSum(ask, 6 as Uint<6>) >= (target as Uint<132>)) ? 1 : 0;
  const u7 = (bidSum(bid, 7 as Uint<6>) >= (target as Uint<132>)
              && bidSum(ask, 7 as Uint<6>) >= (target as Uint<132>)) ? 1 : 0;
  const u8 = (bidSum(bid, 8 as Uint<6>) >= (target as Uint<132>)
              && bidSum(ask, 8 as Uint<6>) >= (target as Uint<132>)) ? 1 : 0;
  const u9 = (bidSum(bid, 9 as Uint<6>) >= (target as Uint<132>)
              && bidSum(ask, 9 as Uint<6>) >= (target as Uint<132>)) ? 1 : 0;
  const u10 = (bidSum(bid, 10 as Uint<6>) >= (target as Uint<132>)
               && bidSum(ask, 10 as Uint<6>) >= (target as Uint<132>)) ? 1 : 0;
  const u11 = (bidSum(bid, 11 as Uint<6>) >= (target as Uint<132>)
               && bidSum(ask, 11 as Uint<6>) >= (target as Uint<132>)) ? 1 : 0;
  const u12 = (bidSum(bid, 12 as Uint<6>) >= (target as Uint<132>)
               && bidSum(ask, 12 as Uint<6>) >= (target as Uint<132>)) ? 1 : 0;
  const u13 = (bidSum(bid, 13 as Uint<6>) >= (target as Uint<132>)
               && bidSum(ask, 13 as Uint<6>) >= (target as Uint<132>)) ? 1 : 0;
  const u14 = (bidSum(bid, 14 as Uint<6>) >= (target as Uint<132>)
               && bidSum(ask, 14 as Uint<6>) >= (target as Uint<132>)) ? 1 : 0;
  const u15 = (bidSum(bid, 15 as Uint<6>) >= (target as Uint<132>)
               && bidSum(ask, 15 as Uint<6>) >= (target as Uint<132>)) ? 1 : 0;
  const u16 = (bidSum(bid, 16 as Uint<6>) >= (target as Uint<132>)
               && bidSum(ask, 16 as Uint<6>) >= (target as Uint<132>)) ? 1 : 0;
  const u17 = (bidSum(bid, 17 as Uint<6>) >= (target as Uint<132>)
               && bidSum(ask, 17 as Uint<6>) >= (target as Uint<132>)) ? 1 : 0;
  const u18 = (bidSum(bid, 18 as Uint<6>) >= (target as Uint<132>)
               && bidSum(ask, 18 as Uint<6>) >= (target as Uint<132>)) ? 1 : 0;
  const u19 = (bidSum(bid, 19 as Uint<6>) >= (target as Uint<132>)
               && bidSum(ask, 19 as Uint<6>) >= (target as Uint<132>)) ? 1 : 0;
  const u20 = (bidSum(bid, 20 as Uint<6>) >= (target as Uint<132>)
               && bidSum(ask, 20 as Uint<6>) >= (target as Uint<132>)) ? 1 : 0;
  const u21 = (bidSum(bid, 21 as Uint<6>) >= (target as Uint<132>)
               && bidSum(ask, 21 as Uint<6>) >= (target as Uint<132>)) ? 1 : 0;
  const u22 = (bidSum(bid, 22 as Uint<6>) >= (target as Uint<132>)
               && bidSum(ask, 22 as Uint<6>) >= (target as Uint<132>)) ? 1 : 0;
  const u23 = (bidSum(bid, 23 as Uint<6>) >= (target as Uint<132>)
               && bidSum(ask, 23 as Uint<6>) >= (target as Uint<132>)) ? 1 : 0;
  const u24 = (bidSum(bid, 24 as Uint<6>) >= (target as Uint<132>)
               && bidSum(ask, 24 as Uint<6>) >= (target as Uint<132>)) ? 1 : 0;
  const u25 = (bidSum(bid, 25 as Uint<6>) >= (target as Uint<132>)
               && bidSum(ask, 25 as Uint<6>) >= (target as Uint<132>)) ? 1 : 0;
  const u26 = (bidSum(bid, 26 as Uint<6>) >= (target as Uint<132>)
               && bidSum(ask, 26 as Uint<6>) >= (target as Uint<132>)) ? 1 : 0;
  const u27 = (bidSum(bid, 27 as Uint<6>) >= (target as Uint<132>)
               && bidSum(ask, 27 as Uint<6>) >= (target as Uint<132>)) ? 1 : 0;
  const u28 = (bidSum(bid, 28 as Uint<6>) >= (target as Uint<132>)
               && bidSum(ask, 28 as Uint<6>) >= (target as Uint<132>)) ? 1 : 0;
  const u29 = (bidSum(bid, 29 as Uint<6>) >= (target as Uint<132>)
               && bidSum(ask, 29 as Uint<6>) >= (target as Uint<132>)) ? 1 : 0;
  const u30 = (bidSum(bid, 30 as Uint<6>) >= (target as Uint<132>)
               && bidSum(ask, 30 as Uint<6>) >= (target as Uint<132>)) ? 1 : 0;
  const u31 = (bidSum(bid, 31 as Uint<6>) >= (target as Uint<132>)
               && bidSum(ask, 31 as Uint<6>) >= (target as Uint<132>)) ? 1 : 0;
  const u32 = (bidSum(bid, 32 as Uint<6>) >= (target as Uint<132>)
               && bidSum(ask, 32 as Uint<6>) >= (target as Uint<132>)) ? 1 : 0;
  const u33 = (bidSum(bid, 33 as Uint<6>) >= (target as Uint<132>)
               && bidSum(ask, 33 as Uint<6>) >= (target as Uint<132>)) ? 1 : 0;
  const u34 = (bidSum(bid, 34 as Uint<6>) >= (target as Uint<132>)
               && bidSum(ask, 34 as Uint<6>) >= (target as Uint<132>)) ? 1 : 0;
  const u35 = (bidSum(bid, 35 as Uint<6>) >= (target as Uint<132>)
               && bidSum(ask, 35 as Uint<6>) >= (target as Uint<132>)) ? 1 : 0;
  const u36 = (bidSum(bid, 36 as Uint<6>) >= (target as Uint<132>)
               && bidSum(ask, 36 as Uint<6>) >= (target as Uint<132>)) ? 1 : 0;
  const u37 = (bidSum(bid, 37 as Uint<6>) >= (target as Uint<132>)
               && bidSum(ask, 37 as Uint<6>) >= (target as Uint<132>)) ? 1 : 0;
  const u38 = (bidSum(bid, 38 as Uint<6>) >= (target as Uint<132>)
               && bidSum(ask, 38 as Uint<6>) >= (target as Uint<132>)) ? 1 : 0;
  const u39 = (bidSum(bid, 39 as Uint<6>) >= (target as Uint<132>)
               && bidSum(ask, 39 as Uint<6>) >= (target as Uint<132>)) ? 1 : 0;
  const u40 = (bidSum(bid, 40 as Uint<6>) >= (target as Uint<132>)
               && bidSum(ask, 40 as Uint<6>) >= (target as Uint<132>)) ? 1 : 0;
  const u41 = (bidSum(bid, 41 as Uint<6>) >= (target as Uint<132>)
               && bidSum(ask, 41 as Uint<6>) >= (target as Uint<132>)) ? 1 : 0;
  const u42 = (bidSum(bid, 42 as Uint<6>) >= (target as Uint<132>)
               && bidSum(ask, 42 as Uint<6>) >= (target as Uint<132>)) ? 1 : 0;
  const u43 = (bidSum(bid, 43 as Uint<6>) >= (target as Uint<132>)
               && bidSum(ask, 43 as Uint<6>) >= (target as Uint<132>)) ? 1 : 0;
  const u44 = (bidSum(bid, 44 as Uint<6>) >= (target as Uint<132>)
               && bidSum(ask, 44 as Uint<6>) >= (target as Uint<132>)) ? 1 : 0;
  const u45 = (bidSum(bid, 45 as Uint<6>) >= (target as Uint<132>)
               && bidSum(ask, 45 as Uint<6>) >= (target as Uint<132>)) ? 1 : 0;
  const u46 = (bidSum(bid, 46 as Uint<6>) >= (target as Uint<132>)
               && bidSum(ask, 46 as Uint<6>) >= (target as Uint<132>)) ? 1 : 0;
  const u47 = (bidSum(bid, 47 as Uint<6>) >= (target as Uint<132>)
               && bidSum(ask, 47 as Uint<6>) >= (target as Uint<132>)) ? 1 : 0;
  const a = ((u0 + u1) as Uint<2>) + ((u2 + u3) as Uint<2>);
  const b = ((u4 + u5) as Uint<2>) + ((u6 + u7) as Uint<2>);
  const c = ((u8 + u9) as Uint<2>) + ((u10 + u11) as Uint<2>);
  const d = ((u12 + u13) as Uint<2>) + ((u14 + u15) as Uint<2>);
  const e = ((u16 + u17) as Uint<2>) + ((u18 + u19) as Uint<2>);
  const f = ((u20 + u21) as Uint<2>) + ((u22 + u23) as Uint<2>);
  const g = ((u24 + u25) as Uint<2>) + ((u26 + u27) as Uint<2>);
  const h = ((u28 + u29) as Uint<2>) + ((u30 + u31) as Uint<2>);
  const i = ((u32 + u33) as Uint<2>) + ((u34 + u35) as Uint<2>);
  const j = ((u36 + u37) as Uint<2>) + ((u38 + u39) as Uint<2>);
  const k = ((u40 + u41) as Uint<2>) + ((u42 + u43) as Uint<2>);
  const l = ((u44 + u45) as Uint<2>) + ((u46 + u47) as Uint<2>);
  const row0 = ((a + b) as Uint<4>) + ((c + d) as Uint<4>);
  const row1 = ((e + f) as Uint<4>) + ((g + h) as Uint<4>);
  const row2 = ((i + j) as Uint<4>) + ((k + l) as Uint<4>);
  return (((row0 + row1) as Uint<6>) + (row2 as Uint<6>)) as Uint<8>;
}

// C1: extract the hashable core of a slot leaf, dropping the circuit-only `present` flag.
circuit slotLeafCore(L: SlotLeaf): SlotLeafCore {
  return SlotLeafCore {
    addr: L.addr, next_addr: L.next_addr, is_protocol: L.is_protocol,
    base_start: L.base_start, base_end: L.base_end, quote_end: L.quote_end,
    lp_base: L.lp_base, lp_quote: L.lp_quote,
    xfer_in: L.xfer_in, xfer_out: L.xfer_out, from_treasury: L.from_treasury,
    swap_base_in: L.swap_base_in, swap_base_out: L.swap_base_out,
    swap_quote_in: L.swap_quote_in, swap_quote_out: L.swap_quote_out,
    depth_root: L.depth_root, flow_root: L.flow_root
  };
}

// C1: internal Merkle node hash H(left, right) = persistentHash<Vector<2, Bytes<32>>>.
// Hashes 4 field elements: [high-8(left), low-248(left), high-8(right), low-248(right)].
// No domain tag — Compact's type system provides implicit domain separation.
// DD-8: CompactHasher.hashNode must use this 4-FE layout, not sha256(left || right).
circuit hashNode(left: Bytes<32>, right: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([left, right]);
}

// C1: apply one Merkle path step.
circuit stepUp(h: Bytes<32>, step: PathStep): Bytes<32> {
  return step.weAreRight ? hashNode(step.sibling, h) : hashNode(h, step.sibling);
}

// C1: verify a depth-16 indexed-Merkle path from leafHash to root.
// Mirrors IndexedMerkleTree.verifyPath (depth 16) in @mmr/merkle.
circuit verifyPath16(leafHash: Bytes<32>, path: Vector<16, PathStep>, root: Bytes<32>): [] {
  const h1  = stepUp(leafHash, path[0]);
  const h2  = stepUp(h1,  path[1]);
  const h3  = stepUp(h2,  path[2]);
  const h4  = stepUp(h3,  path[3]);
  const h5  = stepUp(h4,  path[4]);
  const h6  = stepUp(h5,  path[5]);
  const h7  = stepUp(h6,  path[6]);
  const h8  = stepUp(h7,  path[7]);
  const h9  = stepUp(h8,  path[8]);
  const h10 = stepUp(h9,  path[9]);
  const h11 = stepUp(h10, path[10]);
  const h12 = stepUp(h11, path[11]);
  const h13 = stepUp(h12, path[12]);
  const h14 = stepUp(h13, path[13]);
  const h15 = stepUp(h14, path[14]);
  const h16 = stepUp(h15, path[15]);
  assert(h16 == root, "slot Merkle path mismatch (C1)");
}

// C1: verify a depth-10 pool-tree path from poolLeafHash to rootOfRoots.
// Mirrors RootOfRoots.verifyPoolProof with POOL_TREE_DEPTH=10 in @mmr/merkle.
circuit verifyPoolPath(leafHash: Bytes<32>, path: Vector<10, PathStep>, root: Bytes<32>): [] {
  const h1  = stepUp(leafHash, path[0]);
  const h2  = stepUp(h1,  path[1]);
  const h3  = stepUp(h2,  path[2]);
  const h4  = stepUp(h3,  path[3]);
  const h5  = stepUp(h4,  path[4]);
  const h6  = stepUp(h5,  path[5]);
  const h7  = stepUp(h6,  path[6]);
  const h8  = stepUp(h7,  path[7]);
  const h9  = stepUp(h8,  path[8]);
  const h10 = stepUp(h9,  path[9]);
  assert(h10 == root, "pool inclusion path mismatch (C1)");
}

// I1: committed wallets sorted ascending, no duplicates.
circuit assertSortedUnique(w: Vector<16, Uint<160>>): [] {
  for (const i of 0..15) {
    if (i + 1 < 16) {
      // dummy padding addresses sort to the top; active wallets strictly increase
      assert(w[i] < w[i + 1] || w[i + 1] == 0, "wallets not sorted/unique (I1)");
    }
  }
}

export circuit proveEpoch(
  id: Bytes<32>,
  rootOfRoots: Bytes<32>,
  epoch: Uint<64>
): Uint<8> {
  const w = committedWallets();
  assertSortedUnique(w);

  // Bind the wallet set to the engagement's registration commitment.
  const wc = persistentCommit<Vector<16, Uint<160>>>(w, walletSalt());
  // (verified against registration.walletCommit[id] by the caller contract)

  const leaves = slotLeaves();
  const t = terms();
  const pf = presentFlags(leaves);

  // C1: bind every witness to rootOfRoots via Merkle inclusion proofs.
  const pe = poolEntry();
  const pp = poolPath();
  const sp = slotPaths();

  // Pool inclusion: the engagement's pool tree root is in rootOfRoots.
  verifyPoolPath(persistentHash<PoolEntry>(pe), pp, rootOfRoots);

  // Per-slot: each opened leaf (membership or low-leaf) is in pe.poolRoot.
  // slotLeafCore strips `present` before hashing (19 FEs; atom bytes match encodeLeaf).
  for (const j of 0..15) {
    verifyPath16(persistentHash<SlotLeafCore>(slotLeafCore(leaves[j])), sp[j], pe.poolRoot);
  }

  // I2: each slot opens exactly one leaf under rootOfRoots.
  for (const j of 0..15) {
    const L = leaves[j];
    if (L.present) {
      assert(L.addr == w[j], "membership slot mismatch (I2)");
      assert(!L.is_protocol, "wallet is a protocol contract (I2)");
    } else {
      assert(L.addr < w[j] && (w[j] < L.next_addr || L.next_addr == 0),
             "non-membership low-leaf does not bracket (I2)");
    }
  }

  // I3: custody floor — held value + allowed disposal covers the loan + starting quote.
  // heldBase = Σ (base_end + lp_base) for present slots, ≤ Uint<132>
  const baseEndVec: Vector<16, Uint<128>> = [
    leaves[0].base_end, leaves[1].base_end, leaves[2].base_end, leaves[3].base_end,
    leaves[4].base_end, leaves[5].base_end, leaves[6].base_end, leaves[7].base_end,
    leaves[8].base_end, leaves[9].base_end, leaves[10].base_end, leaves[11].base_end,
    leaves[12].base_end, leaves[13].base_end, leaves[14].base_end, leaves[15].base_end];
  const lpBaseVec: Vector<16, Uint<128>> = [
    leaves[0].lp_base, leaves[1].lp_base, leaves[2].lp_base, leaves[3].lp_base,
    leaves[4].lp_base, leaves[5].lp_base, leaves[6].lp_base, leaves[7].lp_base,
    leaves[8].lp_base, leaves[9].lp_base, leaves[10].lp_base, leaves[11].lp_base,
    leaves[12].lp_base, leaves[13].lp_base, leaves[14].lp_base, leaves[15].lp_base];
  // heldBase: two Uint<132> sums → at most 2^133. heldQuoteAtP: at most 2^197.
  const heldBase = (sumSlots16(baseEndVec, pf) as Uint<133>)
                    + (sumSlots16(lpBaseVec, pf) as Uint<133>);
  const heldQuoteAtP = sumQuoteAtP(leaves, t.floor_price_P);
  // RHS: loan_L0 + quote_start_Q0 × P; P is Uint<64> → product ≤ 2^128 × 2^64 = 2^192.
  const rhsQuote = t.quote_start_Q0 * t.floor_price_P;
  // Step-by-step to stay within Uint<248>; >= handles mixed-width operands.
  const lhsI3 = heldBase + heldQuoteAtP + t.disposal_D;
  const rhsI3 = t.loan_L0 + rhsQuote;
  assert(lhsI3 >= rhsI3, "custody floor breached (I3)");

  // I4: net selling capped.
  const swapInVec: Vector<16, Uint<128>> = [
    leaves[0].swap_base_in, leaves[1].swap_base_in, leaves[2].swap_base_in, leaves[3].swap_base_in,
    leaves[4].swap_base_in, leaves[5].swap_base_in, leaves[6].swap_base_in, leaves[7].swap_base_in,
    leaves[8].swap_base_in, leaves[9].swap_base_in, leaves[10].swap_base_in, leaves[11].swap_base_in,
    leaves[12].swap_base_in, leaves[13].swap_base_in, leaves[14].swap_base_in, leaves[15].swap_base_in];
  const swapOutVec: Vector<16, Uint<128>> = [
    leaves[0].swap_base_out, leaves[1].swap_base_out, leaves[2].swap_base_out, leaves[3].swap_base_out,
    leaves[4].swap_base_out, leaves[5].swap_base_out, leaves[6].swap_base_out, leaves[7].swap_base_out,
    leaves[8].swap_base_out, leaves[9].swap_base_out, leaves[10].swap_base_out, leaves[11].swap_base_out,
    leaves[12].swap_base_out, leaves[13].swap_base_out, leaves[14].swap_base_out, leaves[15].swap_base_out];
  const swapIn = sumSlots16(swapInVec, pf);
  const swapOut = sumSlots16(swapOutVec, pf);
  assert(swapOut <= swapIn + t.net_sell_S, "net selling cap (I4)");

  // I5: outflows capped (excluding the loan inflow from treasury).
  const xferInVec: Vector<16, Uint<128>> = [
    leaves[0].xfer_in, leaves[1].xfer_in, leaves[2].xfer_in, leaves[3].xfer_in,
    leaves[4].xfer_in, leaves[5].xfer_in, leaves[6].xfer_in, leaves[7].xfer_in,
    leaves[8].xfer_in, leaves[9].xfer_in, leaves[10].xfer_in, leaves[11].xfer_in,
    leaves[12].xfer_in, leaves[13].xfer_in, leaves[14].xfer_in, leaves[15].xfer_in];
  const xferOutVec: Vector<16, Uint<128>> = [
    leaves[0].xfer_out, leaves[1].xfer_out, leaves[2].xfer_out, leaves[3].xfer_out,
    leaves[4].xfer_out, leaves[5].xfer_out, leaves[6].xfer_out, leaves[7].xfer_out,
    leaves[8].xfer_out, leaves[9].xfer_out, leaves[10].xfer_out, leaves[11].xfer_out,
    leaves[12].xfer_out, leaves[13].xfer_out, leaves[14].xfer_out, leaves[15].xfer_out];
  const fromTreasuryVec: Vector<16, Uint<128>> = [
    leaves[0].from_treasury, leaves[1].from_treasury, leaves[2].from_treasury, leaves[3].from_treasury,
    leaves[4].from_treasury, leaves[5].from_treasury, leaves[6].from_treasury, leaves[7].from_treasury,
    leaves[8].from_treasury, leaves[9].from_treasury, leaves[10].from_treasury, leaves[11].from_treasury,
    leaves[12].from_treasury, leaves[13].from_treasury, leaves[14].from_treasury, leaves[15].from_treasury];
  const xferIn = sumSlots16(xferInVec, pf);
  const xferOut = sumSlots16(xferOutVec, pf);
  const fromTreasury = sumSlots16(fromTreasuryVec, pf);
  assert(xferOut <= xferIn + t.disposal_D + fromTreasury, "outflow cap (I5)");

  // I6: uptime — count buckets with summed per-slot minimum depth >= target on both sides.
  const bid = bidMin();
  const ask = askMin();
  const uptime = uptimeCount(bid, ask, t.depth_target);

  // I7: round-trip cap — per window, min(buy, sell) is round-trip volume.
  // Flow-root opening and per-window aggregation are omitted in this skeleton;
  // same min(buy,sell)/gross ≤ ppm pattern as the reference oracle.

  // I8 is enforced by the caller: proveEpoch is accepted only if >=2/3 attesters
  // signed rootOfRoots for `epoch` and its challenge window passed unchallenged.

  const epochKey = persistentHash<EpochRef>(EpochRef { id: id, epoch: epoch });
  epochUptime.insert(disclose(epochKey), disclose(uptime as Uint<32>));

  return disclose(uptime);   // uptime bucket count; verdict (all-pass) implied by no revert
}
