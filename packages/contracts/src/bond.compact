// bond.compact — shielded USDM bond escrow + state machine (build-order #3)
//
// UNVERIFIED SKELETON. Semantics follow the engagement state machine and timing
// defaults in the product spec. Bonds are shielded USDM on Midnight (v1);
// cross-chain slashing via VIA Labs is deferred.
//
// The bond keeps the MM's treasury unlinked from the engagement: it is escrowed
// as a shielded token, so the amount and source are private. Only "a valid bond
// of at least the tier minimum exists" is disclosed.
//
// NOTE on receiveShielded: the real postBond must call receiveShielded(coin) to
// take on-chain custody. That call requires a "declared disclosure" annotation
// (Compact 0.31.x privacy analysis). The skeleton omits it; the full
// implementation will add that annotation once the ZSwap API is finalised.

pragma language_version 0.23.0;

import CompactStandardLibrary;

// escrow: map coin-nonce -> escrowed value; tracks shielded USDM held by contract.
// (In production the ZSwap-native coin balance replaces this map.)
export ledger escrow: Map<Bytes<32>, Uint<128>>;
export ledger bondOf: Map<Bytes<32>, Bytes<32>>;   // engagement id -> bond commitment
export ledger slashed: Map<Bytes<32>, Boolean>;

// Timing defaults (seconds) — Compact 0.31.x does not allow top-level const,
// so they are declared locally inside each circuit that needs them.
//
// H3: "now" is the block time, never a caller argument. Compact exposes block time
// only as comparisons (blockTimeGte(t) <=> block time >= t), evaluated on-chain
// against the transaction's block, so each gate asserts blockTimeGte(anchor + WINDOW).
// REMAINING (H3b): the anchors (settledAt, registeredAt, deadline) are still caller
// arguments; they must come from ledger state (settlement / registration records).

witness bondCoin(): ShieldedCoinInfo;  // the shielded USDM the MM posts
witness bondSalt(): Bytes<32>;

// Post a shielded bond for an engagement. Amount stays private; we disclose only
// that a bond >= the tier minimum was posted.
export circuit postBond(id: Bytes<32>, tierMin: Uint<128>): [] {
  const coin = bondCoin();
  assert(coin.value >= tierMin, "bond below tier minimum");
  // NOTE: receiveShielded(coin) omitted — needs declared-disclosure annotation.
  // Tracking the commitment is sufficient for the skeleton's state machine.
  const bc = persistentCommit<ShieldedCoinInfo>(coin, bondSalt());
  bondOf.insert(disclose(id), disclose(bc));
  escrow.insert(disclose(coin.nonce), disclose(coin.value));
}

// Release the bond automatically once an epoch's proof is accepted and its
// challenge window has passed. No client veto (I8 gates acceptance upstream).
export circuit releaseEpoch(id: Bytes<32>, settledAt: Uint<64>): [] {
  const CHALLENGE: Uint<64> = 43200;   // 12h
  assert(blockTimeGte((disclose(settledAt) + CHALLENGE) as Uint<64>), "challenge window open");
  assert(!slashed.member(disclose(id)) || !slashed.lookup(disclose(id)), "already slashed");
  // Partial release logic (per-epoch tranche) omitted in this skeleton.
}

// Anyone can void an unfunded engagement after the funding window — no penalty.
export circuit voidUnfunded(id: Bytes<32>, registeredAt: Uint<64>): [] {
  const FUNDING_WINDOW: Uint<64> = 259200;   // 72h
  assert(blockTimeGte((disclose(registeredAt) + FUNDING_WINDOW) as Uint<64>), "funding window open");
  // transition handled jointly with registration.status; bond returned in full.
}

// Default once the proving window passes with no valid proof (grace handled by
// the caller marking the epoch flagged, not defaulted). Slashes the bond.
export circuit defaultEngagement(id: Bytes<32>, deadline: Uint<64>): [] {
  const PROVING: Uint<64> = 86400;   // 24h after challenge
  assert(blockTimeGte((disclose(deadline) + PROVING) as Uint<64>), "proving window open");
  slashed.insert(disclose(id), true);
}
