// Read-model projection store (PostgreSQL), per specs/architecture.md.
//
// These tables hold ONLY the public read model (display-ready values written by the
// projection worker). They never store clients, tokens, wallets, KPI targets, or raw
// chain data — the privacy filter lives upstream in the worker that fills them. The
// generated client is bound to the ProfileStore port in prisma/profile-store.ts.
//
// [verify] against a live database: `prisma migrate dev` needs DATABASE_URL. The
// generated client is intentionally kept out of the package's typecheck graph (no
// src/ file imports @prisma/client) so CI stays green before `prisma generate`.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Mm {
  handle         String       @id
  displayName    String
  headlineUptime Int
  engagements    Engagement[]
  epochSeries    EpochPoint[]

  @@map("mm")
}

model Engagement {
  recordId       String   @id
  mm             Mm       @relation(fields: [handle], references: [handle], onDelete: Cascade)
  handle         String
  tier           String // "A" | "B" | "C"
  sandbox        Boolean
  epochsPassed   Int
  epochsTotal    Int
  kpiDepth       Int
  kpiUptime      Int
  kpiUtilization Int
  kpiCustody     Int
  kpiNoRoundTrips Int
  custodyIntact  Boolean
  bondPosted     String // pre-formatted, e.g. "$10,000 USDM" or "n/a"
  bondStatus     String // "intact" | "released" | "slashed"
  completedAt    String // ISO date

  @@index([handle])
  @@map("engagement")
}

model EpochPoint {
  id     Int    @id @default(autoincrement())
  mm     Mm     @relation(fields: [handle], references: [handle], onDelete: Cascade)
  handle String
  epoch  Int
  uptime Int
  depth  Int

  @@unique([handle, epoch])
  @@index([handle])
  @@map("epoch_point")
}

// --- Accounts (wallet sign-in) ------------------------------------------------
//
// Who a signed-in identity wallet acts for. The web app's AccountStore port
// (apps/web/src/lib/auth/accounts.ts) is what an adapter over these tables implements;
// until DATABASE_URL is configured, accounts live in a signed cookie in the browser.
//
// PRIVACY: these are IDENTITY wallets used to sign in, never quoting wallets. Quoting
// wallets, KPI terms and salts stay on the MM's machine (committed by hash only).

model Account {
  id        String          @id @default(cuid())
  kind      String // "mm" | "client"
  handle    String?         @unique // public handle (market makers only)
  name      String
  createdAt DateTime        @default(now())
  wallets   AccountWallet[]

  @@map("account")
}

model AccountWallet {
  address   String   @id // lowercase 0x… identity wallet
  accountId String
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  chainId   Int // chain the wallet signed in on (1 or 8453)
  linkedAt  DateTime @default(now())

  @@index([accountId])
  @@map("account_wallet")
}
