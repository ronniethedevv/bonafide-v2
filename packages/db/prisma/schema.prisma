// Read-model projection store (PostgreSQL), per specs/architecture.md.
//
// These tables hold ONLY the public read model (display-ready values written by the
// projection worker). They never store clients, tokens, wallets, KPI targets, or raw
// chain data — the privacy filter lives upstream in the worker that fills them. The
// generated client is bound to the ProfileStore port in prisma/profile-store.ts.
//
// [verify] against a live database: `prisma migrate dev` needs DATABASE_URL. The
// generated client is intentionally kept out of the package's typecheck graph (no
// src/ file imports @prisma/client) so CI stays green before `prisma generate`.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Mm {
  handle         String       @id
  displayName    String
  headlineUptime Int
  engagements    Engagement[]
  epochSeries    EpochPoint[]

  @@map("mm")
}

model Engagement {
  recordId       String   @id
  mm             Mm       @relation(fields: [handle], references: [handle], onDelete: Cascade)
  handle         String
  tier           String // "A" | "B" | "C"
  sandbox        Boolean
  epochsPassed   Int
  epochsTotal    Int
  kpiDepth       Int
  kpiUptime      Int
  kpiUtilization Int
  kpiCustody     Int
  kpiNoRoundTrips Int
  custodyIntact  Boolean
  bondPosted     String // pre-formatted, e.g. "$10,000 USDM" or "n/a"
  bondStatus     String // "intact" | "released" | "slashed"
  completedAt    String // ISO date

  @@index([handle])
  @@map("engagement")
}

model EpochPoint {
  id     Int    @id @default(autoincrement())
  mm     Mm     @relation(fields: [handle], references: [handle], onDelete: Cascade)
  handle String
  epoch  Int
  uptime Int
  depth  Int

  @@unique([handle, epoch])
  @@index([handle])
  @@map("epoch_point")
}
